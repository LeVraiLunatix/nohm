# Dependencies
node_modules/

# Builds
client/dist/
server/dist/

# Secrets — never commit these
.env
.env.*
!.env.example
# Not a secret — just a build flag for the public demo build (see client/src/demo/).
!client/.env.demo
# No trailing slash: install-launchd.sh replaces these with symlinks into the shared
# state dir, and a trailing-slash pattern matches only real directories — so `foo/`
# would silently stop ignoring them the moment they become links.
server/.tokens
server/.data

# Personal settings (calendar names, feeds, local repo paths).
# Start from server/config.example.json — a missing config.json just uses defaults.
server/config.json

# scripts/backfillValorantHistory.ts --apply dumps the previous cache row here before overwriting.
server/.valorant-history-backup-*.json

# Rust / Tauri build output
src-tauri/target/
src-tauri/gen/

# Tauri updater signing key — the .pub content lives in tauri.conf.json; the private
# key goes into the TAURI_SIGNING_PRIVATE_KEY GitHub secret, never here.
src-tauri/.nohm-updater.key
src-tauri/.nohm-updater.key.pub

# Staged for the Windows bundle by src-tauri/scripts/prepare-resources.mjs
src-tauri/binaries/
src-tauri/resources/

# Logs & OS noise
*.log
.DS_Store
/.vscode
/.claude
/.codex
