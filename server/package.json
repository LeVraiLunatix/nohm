{
  "name": "@nohm/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "predev": "cross-env PORT=4822 tsx scripts/freePort.ts",
    "dev": "cross-env PORT=4822 tsx watch src/index.ts",
    "wait-ready": "cross-env PORT=4822 tsx scripts/waitForServer.ts",
    "start": "cross-env NODE_ENV=production tsx src/index.ts",
    "start:ingest": "cross-env NODE_ENV=production tsx src/ingest.ts",
    "test": "vitest run",
    "setup:gmail": "tsx scripts/setupGmail.ts",
    "setup:spotify": "tsx scripts/setupSpotify.ts",
    "setup:hue": "tsx scripts/setupHue.ts",
    "doctor:live": "tsx scripts/doctorLive.ts",
    "doctor:codex": "tsx scripts/doctorCodex.ts",
    "precommit:scope": "tsx scripts/precommitScope.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:import-json": "tsx scripts/importJsonToPostgres.ts",
    "seed:spotify-streams": "tsx scripts/seedSpotifyStreams.ts",
    "screenshots": "tsx scripts/screenshots.ts",
    "typecheck": "tsc --noEmit",
    "db:cleanup-duplicates": "tsx scripts/cleanupDuplicateSignals.ts"
  },
  "dependencies": {
    "@nohm/shared": "*",
    "ccusage": "20.0.17",
    "cross-env": "^10.0.0",
    "dotenv": "^17.2.0",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "googleapis": "^173.0.0",
    "node-ical": "^0.26.1",
    "octokit": "^5.0.5",
    "postgres": "^3.4.7",
    "rss-parser": "^3.13.0",
    "tsdav": "^2.3.1",
    "tsx": "^4.20.0",
    "zod": "^4.0.0"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "drizzle-kit": "^0.31.4",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.61.1",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
