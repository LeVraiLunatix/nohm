{
  "name": "nohm",
  "private": true,
  "version": "0.1.0",
  "description": "Nohm — centre de contrôle personnel local",
  "engines": {
    "node": ">=22.5.0"
  },
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run predev -w server && concurrently -n server,client -c blue,magenta \"npm run dev -w server\" \"npm run wait-ready -w server && npm run dev -w client\"",
    "build": "npm run build -w client",
    "build:demo": "npm run build:demo -w client",
    "start": "npm run start -w server",
    "test": "npm test -w server",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "doctor:live": "npm run doctor:live -w server",
    "doctor:codex": "npm run doctor:codex -w server",
    "precommit:scope": "npm run precommit:scope -w server",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tauri-apps/cli": "^2.8.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "typescript-eslint": "^8.68.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  },
  "overrides": {
    "brace-expansion@2.0.0 - 2.1.3": "2.1.4"
  }
}
